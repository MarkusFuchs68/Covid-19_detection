   "source": [
    "# Variables\n",
    "dataset_folder = r'C:\\Users\\Thoma\\Downloads\\Python\\dataset' # We stored the masked files in this dataset folder\n",
    "class_normal = 'normal'\n",
    "class_lung_opacity = 'lung_opacity'\n",
    "class_viral_pneumonia = 'viral_pneumonia'\n",
    "class_covid = 'covid'"
   ]
  },
